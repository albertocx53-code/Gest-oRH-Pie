<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../Aurora.Core/Aurora.Core.csproj" />
    <!-- Camada de acesso aos dados (SQLite) -->
    <ProjectReference Include="../Aurora.Dados/Aurora.Dados.csproj" />
    <InternalsVisibleTo Include="Aurora.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Imagens da tela Sobre o projeto. São copiadas junto com o programa. -->
    <None Include="Imagens/*.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
